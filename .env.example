# Oracle connection (use a SELECT-only account)
DB_CONNECT_STRING=localhost:1521/ORCL
DB_USER=readonly_user
DB_PASSWORD=change-me

# Directory containing Oracle Instant Client 19c (required on Windows unless it is on PATH)
ORACLE_CLIENT_LIB_DIR=C:\oracle\instantclient_19_x

# Value clients must send in the X-API-Key header
API_KEY=change-me

# Optional
PORT=3000
HOST=127.0.0.1
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
